# capstan dev MySQL substrate: the MySQL 8.0 and 8.4 servers the suite streams from.
#
# Copy to .env (gitignored):  cp .env.example .env
# This repository ships no database container; docs/testing.md gives the flags and a `docker run`
# line for each server. On the maintainer's machine the servers run in the BaseLabs cluster
# (namespace capstan, ports below) and nothing is started locally: if a server is unreachable
# there, stop and report it.
#
# Credentials here are THROWAWAY test values, not secrets; never put a real password in .env.

# --- host ports (bind 127.0.0.1 only). The Elixir suite reads MYSQL_PORT_80 via Dotenvy
#     (Capstan.MysqlCase.shared_port/0); nothing in lib/ or test/ hard-codes a port. ---
MYSQL_PORT_80=11619
MYSQL_PORT_84=15401

# --- credentials (throwaway, local-only) ---
MYSQL_ROOT_PASSWORD=probe
MYSQL_DATABASE=probe_db
CAPSTAN_SHA2_USER=capstan_sha2
CAPSTAN_SHA2_PASSWORD=capstan_sha2_pw
# Path to the 8.0 server's ca.pem (TLS handshake test); the BaseLabs cluster exports it to
# ~/.config/baselabs/capstan/mysql-80-ca.pem.
CAPSTAN_SUBSTRATE_CA_FILE=

# --- the disposable MySQL 8.0 (the :disposable_mysql marquees reset it; never a shared server).
#     Unset: those marquees cannot run (they are excluded unless selected). It must carry the
#     `capstan_disposable` schema (docs/testing.md), or the suite refuses to touch it. ---
CAPSTAN_DISPOSABLE_MYSQL_PORT=
