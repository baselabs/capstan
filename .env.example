# capstan dev MySQL substrate — tunables for docker-compose.yml and scripts/dev-substrate.sh.
#
# Copy to .env (gitignored) and adjust as needed:  cp .env.example .env
# The defaults below reproduce the committed substrate exactly, so an unedited copy Just Works.
#
# ⚠️  Credentials here are THROWAWAY for disposable LOCAL containers — NOT secrets, never reused
#     anywhere real. Do not put a real password in .env; .env is gitignored precisely so a local
#     override never lands in git.

# --- images (pin a patch tag here to reproduce a specific server build) ---
MYSQL_IMAGE_80=mysql:8.0
MYSQL_IMAGE_84=mysql:8.4

# --- host ports (random high ports; bind 127.0.0.1 only). Env-driven end-to-end: docker-compose
#     binds these, and the Elixir suite reads MYSQL_PORT_80 via Dotenvy → Capstan.MysqlCase.shared_port/0.
#     Change them freely — nothing in lib/ or test/ hard-codes a port. ---
MYSQL_PORT_80=11619
MYSQL_PORT_84=15401

# --- container names (keep these: handshake_test.exs does `docker exec mysql-cdc-probe …` for the
#     CA cert, and AGENTS.md documents them) ---
MYSQL_CONTAINER_80=mysql-cdc-probe
MYSQL_CONTAINER_84=mysql-cdc-probe-84

# --- credentials (throwaway, local-only) ---
MYSQL_ROOT_PASSWORD=probe
MYSQL_DATABASE=probe_db
CAPSTAN_SHA2_USER=capstan_sha2
CAPSTAN_SHA2_PASSWORD=capstan_sha2_pw
