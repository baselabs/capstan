# capstan dev MySQL substrate: the MySQL 8.0 and 8.4 servers the suite streams from.
#
# Copy to .env (gitignored):  cp .env.example .env
# This repository ships no database container; docs/testing.md gives the flags and a `docker run`
# line for each server. On the maintainer's machine the servers run in the BaseLabs cluster
# (namespace capstan, ports below) and nothing is started locally: if a server is unreachable
# there, stop and report it.
#
# Credentials here are THROWAWAY test values, not secrets; never put a real password in .env.

# --- host ports (bind 127.0.0.1 only). The Elixir suite reads MYSQL_PORT_80 via Dotenvy
#     (Capstan.MysqlCase.shared_port/0); nothing in lib/ or test/ hard-codes a port. ---
MYSQL_PORT_80=11619
MYSQL_PORT_84=15401

# --- credentials (throwaway, local-only) ---
MYSQL_ROOT_PASSWORD=probe
MYSQL_DATABASE=probe_db
CAPSTAN_SHA2_USER=capstan_sha2
CAPSTAN_SHA2_PASSWORD=capstan_sha2_pw
# Path to the 8.0 server's ca.pem (TLS handshake test); the BaseLabs cluster exports it to
# ~/.config/baselabs/capstan/mysql-80-ca.pem.
CAPSTAN_SUBSTRATE_CA_FILE=

# --- the disposable MySQL 8.0 (the :disposable_mysql marquees reset it; never a shared server).
#     Unset: those marquees cannot run (they are excluded unless selected). It must carry the
#     `capstan_disposable` schema (docs/testing.md), or the suite refuses to touch it. ---
CAPSTAN_DISPOSABLE_MYSQL_PORT=

# --- a real Amazon Aurora MySQL version 3 cluster (ADR-0013, the :aurora_mysql marquees;
#     excluded unless selected). HOST is the CLUSTER (writer) endpoint, CA_FILE the AWS RDS
#     CA bundle (hostname verification stays ON). The failover/snapshot marquees need
#     AURORA_MYSQL_CLUSTER_ID (aws rds failover-db-cluster), the reader marquee
#     AURORA_MYSQL_READER_HOST, and the misconfiguration-refusal module
#     AURORA_MYSQL_MISCONFIG (one of: binlog_format_off, log_bin_off,
#     binlog_format_statement, binlog_format_mixed, binlog_row_metadata_minimal,
#     gtid_mode_off — the cluster is re-parameterized to carry exactly that, and that
#     module runs ALONE against it). Values live only in the environment; none is
#     printed, logged or committed. ---
AURORA_MYSQL_HOST=
AURORA_MYSQL_PORT=
AURORA_MYSQL_USER=
AURORA_MYSQL_PASSWORD=
AURORA_MYSQL_CA_FILE=
AURORA_MYSQL_CLUSTER_ID=
AURORA_MYSQL_READER_HOST=
AURORA_MYSQL_MISCONFIG=

# --- the LOCAL Aurora-failover simulator (ADR-0013's simulator arm; scripts/aurora-sim/).
#     Three real MySQL 8.0 nodes behind an HAProxy endpoint the :aurora_sim marquees flip —
#     no AWS account needed. The defaults ARE the compose stack's ports; override only if
#     you remapped them. Credentials are the stack's throwaway ones. ---
AURORA_SIM_HOST=127.0.0.1
AURORA_SIM_USER=root
AURORA_SIM_PASSWORD=probe
AURORA_SIM_ENDPOINT_PORT=37521
AURORA_SIM_WRITER_PORT=37524
AURORA_SIM_PROMOTABLE_PORT=37525
AURORA_SIM_READER_PORT=37527
AURORA_SIM_ADMIN_PORT=37528
